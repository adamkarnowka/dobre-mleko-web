{
  "name": "dobre-mleko-web",
  "version": "0.1.0",
  "private": true,
  "description": "Dobre Mleko web app and admin dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ${API_SPEC:-https://mwalczak.github.io/dobre-mleko-be/openapi.json} -o src/shared/api-schema.d.ts && prettier --write src/shared/api-schema.d.ts",
    "format": "prettier --write src e2e *.ts",
    "format:check": "prettier --check src e2e *.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "blurhash": "^2.0.5",
    "maplibre-gl": "^6.14.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
